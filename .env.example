# .env.example — Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Your Discord bot token (from the Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=your_bot_token_here

# The numeric ID of the Discord server (guild) the bot will be used in.
# Right-click your server icon with Developer Mode enabled → Copy Server ID.
GUILD_ID=your_guild_id_here

# HuggingFace token for speaker diarization (pyannote.audio).
# Get your token at https://huggingface.co/settings/tokens
# You must also accept the pyannote model licence at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here
